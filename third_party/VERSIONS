# Pinned third-party versions for the Coder Framework.
#
# Rules:
#   - Change only through a reviewed pull request.
#   - opencode: the harness compatibility suite (tests/harness_compat,
#     scenarios H1-H15) must pass before the version is bumped, and the
#     suite must be re-run in CI against every candidate version.
#   - Models: exact versions are fixed for a run and recorded in the run
#     store; the golden evaluation suite (§17.2) is re-run before a change.

opencode: 1.18.35
opencode_api: v1 (/session, /event); the /api/* family exists but its session drain is not enabled in this build (Phase 0a finding)
vcpkg_baseline: e456309491fd875487bf02b8a0dca76c1b1b00cc

# Vendored under third_party/tree-sitter-*/ (generated parser.c, scanners,
# headers and LICENSEs), because the vcpkg grammar ports regenerate the
# parser with a prebuilt tree-sitter-cli that needs GLIBC 2.39, newer than
# the build host's glibc. tree-sitter runtime comes from vcpkg (0.26.12);
# ABI versions 14-15 parsers are compatible with it. The python grammar's
# scanner also needs the runtime's internal array.h/alloc.h/ts_assert.h,
# vendored next to it from the runtime at the vcpkg version.
tree_sitter_c: 0.24.2      # github.com/tree-sitter/tree-sitter-c v0.24.2, tarball sha256 2eeb4db31f8fa0865e45488503d13403923bcb485a1bdb637abff8c42dd97364
tree_sitter_python: 0.23.6 # github.com/tree-sitter/tree-sitter-python v0.23.6, tarball sha256 630a0f45eccd9b69a66a07bf47d1568e96a9c855a2f30e0921c8af7121e8af96
tree_sitter_go: 0.23.4     # github.com/tree-sitter/tree-sitter-go v0.23.4, tarball sha256 967870d7d120e9b760e538aeb8331a72f70ffcca4f1eaf1e1dea5375886d25d2
tree_sitter_typescript: 0.23.2 # github.com/tree-sitter/tree-sitter-typescript v0.23.2, tarball sha256 2c4ce711ae8d1218a3b2f899189298159d672870b5b34dff5d937bed2f3e8983
tree_sitter_java: 0.23.5   # github.com/tree-sitter/tree-sitter-java v0.23.5, tarball sha256 cb199e0faae4b2c08425f88cbb51c1a9319612e7b96315a174a624db9bf3d9f0
tree_sitter_cpp: 0.23.4    # github.com/tree-sitter/tree-sitter-cpp v0.23.4, tarball sha256 7a2c55afe3028f4105f25762ea58cc16537d1f5a1dcd9cca90410b3cd5d46051

llvm: 17          # Clang LibTooling C/C++ code intelligence + cf-tidy company checks (Phase 1+); optional, configure LLVM_DIR/Clang_DIR
gcc_min: 11       # framework builds with GCC 11+
clang_min: 17     # framework builds with Clang 17+

